# LakeB2B Social Post Creator - Environment Variables
# Copy this file to .env.local and fill in your values

# ============================================================
# Gemini API (Required for image generation and local scripts)
# ============================================================
# Get a key from https://aistudio.google.com/app/apikey
# The app and list-gemini-models.js both read GEMINI_API_KEY.
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================================
# Authentication (Better-Auth)
# ============================================================
# Generate secure secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=your-32-byte-hex-secret
BETTER_AUTH_URL=http://localhost:3000
# JWT Secret for legacy/fallback auth
JWT_SECRET=your-secure-jwt-secret-key

# ============================================================
# Database Configuration (Supabase PostgreSQL)
# ============================================================
# Get connection strings from Supabase Dashboard > Settings > Database
# Use "Transaction" connection string for DATABASE_URL (connection pooler)
# Use "Session" connection string for DIRECT_URL (direct connection for migrations)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Database provider (must match prisma/schema.prisma datasource provider)
# Values: postgresql (default for Vercel/Supabase) or sqlite (for local dev only)
DATABASE_PROVIDER=postgresql

# ============================================================
# Supabase Configuration (Optional - for Supabase Auth if used)
# ============================================================
# Get these from your Supabase project dashboard at https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================================
# LinkedIn OAuth (Required for LinkedIn Integration)
# ============================================================
# Get these from https://developer.linkedin.com
# Required products: "Sign In with LinkedIn using OpenID Connect" and "Share on LinkedIn"
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/auth/linkedin/callback

# Token encryption key (32 bytes / 64 hex characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LINKEDIN_TOKEN_ENCRYPTION_KEY=your_64_char_hex_key_here

# ============================================================
# Redis (Required for Docker, Optional for Vercel)
# ============================================================
# Docker: Uses redis://redis:6379 (set automatically by docker-compose)
# Vercel: Use Upstash Redis or leave empty (graceful fallback)
REDIS_URL=redis://localhost:6379

# ============================================================
# Rate Limiting (Optional - for production with Upstash)
# ============================================================
# Get these from https://upstash.com (optional - defaults to in-memory)
# UPSTASH_REDIS_REST_URL=your_upstash_url
# UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# ============================================================
# Vercel Cron (Required for scheduled LinkedIn posts)
# ============================================================
# Secret for authenticating cron job requests
CRON_SECRET=your-cron-secret-key

# ============================================================
# PostHog Analytics (Optional - product analytics)
# ============================================================
# Get these from https://posthog.com/settings
# NEXT_PUBLIC_POSTHOG_KEY=phc_your_key_here
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ============================================================
# Sentry Error Tracking (Optional - error monitoring)
# ============================================================
# Get these from https://sentry.io/settings
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# SENTRY_ORG=your_org_name
# SENTRY_PROJECT=your_project_name
# SENTRY_AUTH_TOKEN=your_auth_token

# ============================================================
# Cloudinary (Optional - image hosting/CDN)
# ============================================================
# Get these from https://cloudinary.com/console
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# ============================================================
# Twitter/X API (Optional - social posting)
# ============================================================
# Get these from https://developer.twitter.com/en/portal/dashboard
# TWITTER_CLIENT_ID=your_client_id
# TWITTER_CLIENT_SECRET=your_client_secret
# TWITTER_CALLBACK_URL=http://localhost:3000/api/twitter/callback

# ============================================================
# App Configuration
# ============================================================
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_VERSION=1.0.0

# ============================================================
# Docker Self-Hosting (Only needed for docker-compose deployment)
# ============================================================
# PostgreSQL password for Docker deployment
# Generate with: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
POSTGRES_PASSWORD=your_secure_postgres_password
