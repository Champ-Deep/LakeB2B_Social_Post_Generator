    "test:unit:coverage": "vitest run --coverage",
    "test:all": "npm run test:unit && npm run test",
    "start:auto": "node scripts/auto-start.js start",
    "server:status": "node scripts/auto-start.js status",
    "server:stop": "node scripts/auto-start.js stop",
